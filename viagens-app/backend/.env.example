# Copie para .env e preencha. NUNCA envie o .env para o Git.

# Porta do servidor
PORT=8787

# Endereços (origens) do frontend que podem chamar esta API, separados por vírgula.
# Ex.: https://seu-usuario.github.io,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# --- Voos e hotéis: SerpApi (dados do Google Flights e Google Hotels) ---
# Cadastro: https://serpapi.com/users/sign_up  (plano gratuito: 250 buscas/mês)
SERPAPI_KEY=

# --- Voos: Duffel (ofertas ao vivo das companhias) ---
# Cadastro: https://app.duffel.com  — preços reais só com a conta ativada (modo "live").
# Tokens de teste (duffel_test_...) devolvem preços FICTÍCIOS: o app os descarta,
# a menos que DUFFEL_ALLOW_TEST=true (aí eles aparecem marcados como teste).
DUFFEL_TOKEN=
DUFFEL_ALLOW_TEST=false

# --- Ofertas da página inicial (opcional, gasta buscas da SerpApi) ---
# Origem e destinos monitorados; atualizados no máximo a cada DEALS_REFRESH_HOURS.
DEALS_ORIGIN=
DEALS_DESTINATIONS=
DEALS_DAYS_AHEAD=30
DEALS_REFRESH_HOURS=12

# --- Contas e viagens na nuvem ---
# Arquivo do banco SQLite (criado sozinho).
DATABASE_FILE=./data/viagens.db
# Deixe false para desligar o cadastro de contas.
ACCOUNTS_ENABLED=true

# Limite de buscas por IP por minuto (protege suas cotas).
RATE_LIMIT_PER_MINUTE=20
